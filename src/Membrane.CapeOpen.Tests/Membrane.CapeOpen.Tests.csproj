<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Prefer the repo-vendored PIA (lib/CAPE-OPENv1-1-0.dll); fall back to the machine install. -->
    <CapeOpenPia Condition="Exists('$(MSBuildProjectDirectory)\..\..\lib\CAPE-OPENv1-1-0.dll')">$(MSBuildProjectDirectory)\..\..\lib\CAPE-OPENv1-1-0.dll</CapeOpenPia>
    <CapeOpenPia Condition="'$(CapeOpenPia)' == '' And Exists('$(CommonProgramFiles)\CAPE-OPEN\Reference Assemblies\CAPE-OPENv1-1-0.dll')">$(CommonProgramFiles)\CAPE-OPEN\Reference Assemblies\CAPE-OPENv1-1-0.dll</CapeOpenPia>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Membrane.CapeOpen\Membrane.CapeOpen.csproj" />
    <ProjectReference Include="..\MembraneCore\MembraneCore.csproj" />
    <!-- Private=true so the .NET 8 test host can load the interop assembly at runtime. -->
    <Reference Include="CAPE-OPENv1-1-0">
      <HintPath>$(CapeOpenPia)</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

</Project>
