<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway console app: runs the MembraneCore solvers and dumps CSVs that the
       matplotlib make_*.py scripts turn into the validation figures. Not part of the
       product build; run manually with `dotnet run` from this directory. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>gen</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\MembraneCore\MembraneCore.csproj" />
  </ItemGroup>

</Project>
