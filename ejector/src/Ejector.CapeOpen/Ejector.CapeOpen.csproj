<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows + EnableComHosting (as the membrane unit): a native Ejector.CapeOpen.comhost.dll is the
         COM InprocServer32, so .NET-based hosts (DWSIM) get a real COM RCW and native hosts (COFE/COCO,
         Aspen, UniSim) are unaffected. Requires the .NET 8 Desktop runtime on the target machine. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnableComHosting>true</EnableComHosting>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Ejector.CapeOpen</RootNamespace>
    <AssemblyName>Ejector.CapeOpen</AssemblyName>
    <ComVisible>false</ComVisible>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <Description>CAPE-OPEN 1.0 ejector / jet-pump unit operation (one-dimensional real-fluid model, constant-area mixing). Delegates physics to EjectorCore and thermodynamics (PH/PS/PT/PQ flashes) to the PME property package.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="register.bat" CopyToOutputDirectory="PreserveNewest" />
    <None Include="unregister.bat" CopyToOutputDirectory="PreserveNewest" />
    <None Include="register-user.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="unregister-user.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EjectorCore\EjectorCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ejector.CapeOpen.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- CO-LaN 1.1 PIA (superset of the 1.0 unit + thermo interfaces): repo-vendored copy, else machine install. -->
    <CapeOpenPia Condition="Exists('$(MSBuildProjectDirectory)\..\..\..\lib\CAPE-OPENv1-1-0.dll')">$(MSBuildProjectDirectory)\..\..\..\lib\CAPE-OPENv1-1-0.dll</CapeOpenPia>
    <CapeOpenPia Condition="'$(CapeOpenPia)' == '' And Exists('$(CommonProgramFiles)\CAPE-OPEN\Reference Assemblies\CAPE-OPENv1-1-0.dll')">$(CommonProgramFiles)\CAPE-OPEN\Reference Assemblies\CAPE-OPENv1-1-0.dll</CapeOpenPia>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="CAPE-OPENv1-1-0">
      <HintPath>$(CapeOpenPia)</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

</Project>
